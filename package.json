{
  "name": "graphpaper",
  "version": "0.1.0",
  "description": "Framework-agnostic diagram renderer — lay out a neutral node/edge DiagramModel with ELK and render interactive SVG.",
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./index.d.ts",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "pack:check": "npm pack --dry-run --json",
    "test:install": "node scripts/check-pack-install.mjs",
    "verify": "npm test && npm run pack:check && npm run test:install",
    "prepublishOnly": "npm run verify"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    },
    "./diagram.css": "./diagram.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "index.d.ts",
    "diagram.css",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "diagram",
    "graph",
    "elk",
    "svg",
    "layout",
    "visualization",
    "architecture"
  ],
  "peerDependencies": {
    "elkjs": "^0.10.2"
  },
  "peerDependenciesMeta": {
    "elkjs": {
      "optional": true
    }
  }
}
