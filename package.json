{
  "name": "@scshafe/graphpaper",
  "version": "0.5.2",
  "description": "Framework-agnostic diagram renderer — lay out a neutral node/edge DiagramModel with ELK and render interactive SVG.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/scshafe/graphpaper.git"
  },
  "bugs": {
    "url": "https://github.com/scshafe/graphpaper/issues"
  },
  "homepage": "https://github.com/scshafe/graphpaper#readme",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.22.0 <23 || >=24.18.0 <25"
  },
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./index.d.ts",
  "scripts": {
    "build": "node -e \"console.log('graphpaper has no build step: src/, index.d.ts and diagram.css ship as written')\"",
    "clean": "node scripts/clean.mjs",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit --strict --skipLibCheck false --target ES2022 --lib ES2022,DOM --module NodeNext --moduleResolution NodeNext index.d.ts",
    "test:payload": "node scripts/check-package-payload.mjs",
    "test:release-artifact": "node scripts/check-release-artifact.mjs",
    "test:install": "node scripts/check-pack-install.mjs",
    "test:fresh-clone": "node scripts/check-fresh-clone.mjs",
    "verify": "pnpm run test && pnpm run typecheck && pnpm run test:payload && pnpm run test:release-artifact && pnpm run test:install",
    "prepublishOnly": "pnpm run verify",
    "release:manifest": "node scripts/write-release-manifest.mjs"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    },
    "./diagram.css": "./diagram.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "index.d.ts",
    "diagram.css",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "sideEffects": false,
  "keywords": [
    "diagram",
    "graph",
    "elk",
    "svg",
    "layout",
    "visualization",
    "architecture"
  ],
  "peerDependencies": {
    "elkjs": "^0.10.2"
  },
  "peerDependenciesMeta": {
    "elkjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "elkjs": "0.10.2",
    "typescript": "^5.9.3"
  }
}
